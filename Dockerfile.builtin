ARG PG_MAJOR=18
FROM debian:11

ARG PG_MAJOR=18
ARG EXPECTED_MD5
ARG LOCALE=C

ENV PG_MAJOR=${PG_MAJOR}
ENV EXPECTED_MD5=${EXPECTED_MD5}
ENV TEST_LOCALE=${LOCALE}
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
    && mkdir -p /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
       | gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt bullseye-pgdg main" \
       > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && if [ "${PG_MAJOR}" = "19" ]; then \
         groupadd --system postgres \
         && useradd --system --gid postgres --home-dir /var/lib/postgresql --shell /bin/bash postgres \
         && apt-get install -y --no-install-recommends \
              build-essential \
              bison \
              flex \
              libicu-dev \
         && curl -fsSL https://ftp.postgresql.org/pub/source/v19beta2/postgresql-19beta2.tar.bz2 \
              -o /tmp/postgresql-19beta2.tar.bz2 \
         && tar -xjf /tmp/postgresql-19beta2.tar.bz2 -C /tmp \
         && cd /tmp/postgresql-19beta2 \
         && ./configure --prefix=/usr/local/pgsql/19 --without-icu --without-llvm --without-readline --without-zlib \
         && make -j2 \
         && make install \
         && rm -rf /tmp/postgresql-19beta2 /tmp/postgresql-19beta2.tar.bz2; \
       else \
         apt-get install -y --no-install-recommends \
             postgresql-${PG_MAJOR} \
             postgresql-client-${PG_MAJOR}; \
       fi \
    && rm -rf /var/lib/apt/lists/*

COPY --chmod=644 unicode-sorting.sql unicode-sorting-md5.sql /opt/unicode-sorting/
WORKDIR /opt/unicode-sorting

RUN mkdir -p /var/lib/postgresql/${PG_MAJOR}/builtin \
    && chown -R postgres:postgres /var/lib/postgresql/${PG_MAJOR}/builtin /opt/unicode-sorting \
    && chmod 755 /opt/unicode-sorting \
    && pg_bin=/usr/lib/postgresql/${PG_MAJOR}/bin \
    && if [ "${PG_MAJOR}" = "19" ]; then pg_bin=/usr/local/pgsql/19/bin; fi \
    && su postgres -c "${pg_bin}/initdb -D /var/lib/postgresql/${PG_MAJOR}/builtin --encoding=UTF8 --locale=C"

CMD set -eu; \
    test_started="$(date +%s)"; \
    pg_bin="/usr/lib/postgresql/${PG_MAJOR}/bin"; \
    if [ "${PG_MAJOR}" = "19" ]; then pg_bin="/usr/local/pgsql/19/bin"; fi; \
    pg_version="$(${pg_bin}/postgres --version | sed 's/^postgres (PostgreSQL) //')"; \
    su postgres -c "${pg_bin}/pg_ctl -D /var/lib/postgresql/${PG_MAJOR}/builtin -o \"-c listen_addresses=''\" -l /tmp/postgresql.log start"; \
    if su postgres -c "${pg_bin}/psql -Atqc \"SELECT 1 FROM pg_settings WHERE name = 'max_parallel_workers_per_gather'\"" | grep -q 1; then \
      su postgres -c "${pg_bin}/psql -v ON_ERROR_STOP=1 -c \"ALTER SYSTEM SET max_parallel_workers_per_gather = 0;\""; \
      su postgres -c "${pg_bin}/pg_ctl -D /var/lib/postgresql/${PG_MAJOR}/builtin reload"; \
    fi; \
    curl -ks "https://www.unicode.org/Public/15.0.0/ucd/UnicodeData.txt" | cut -d';' -f1-3 > /opt/unicode-sorting/UnicodeData.txt; \
    chmod 644 /opt/unicode-sorting/UnicodeData.txt; \
    su postgres -c "${pg_bin}/psql -v ON_ERROR_STOP=1 -v UNICODE_VERS=15 -v UNICODE_FILE=/opt/unicode-sorting/UnicodeData.txt -c \"SET work_mem = '2097151kB';\" -f /opt/unicode-sorting/unicode-sorting.sql"; \
    sed "s/@LOCALE@/\"${TEST_LOCALE}\"/g" /opt/unicode-sorting/unicode-sorting-md5.sql > /tmp/unicode-sorting-md5.sql; \
    su postgres -c "${pg_bin}/psql -At -v ON_ERROR_STOP=1 -f /tmp/unicode-sorting-md5.sql" | tee /tmp/unicode-sorting-md5-output; \
    result="$(sed -n 's/^[0-9a-f][0-9a-f]*$/&/p' /tmp/unicode-sorting-md5-output | tail -1)"; \
    echo "locale=${TEST_LOCALE} md5=${result} expected=${EXPECTED_MD5}"; \
    echo "postgresql_version=${pg_version} test_runtime_seconds=$(( $(date +%s) - test_started ))"; \
    if [ -n "${EXPECTED_MD5}" ]; then \
      test "${result}" = "${EXPECTED_MD5}"; \
    else \
      echo 'No expected MD5 supplied; checksum was not compared'; \
      exit 2; \
    fi
